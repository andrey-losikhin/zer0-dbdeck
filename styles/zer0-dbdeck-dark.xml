<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="zer0-dbdeck-dark" name="DBDeck Dark" version="1.0">
  <author>zer0-dbdeck</author>
  <description>Catppuccin Mocha SQL editor colors for zer0-dbdeck.</description>

  <color name="background" value="#1e1e2e" />
  <color name="foreground" value="#cdd6f4" />
  <color name="gutter" value="#181825" />
  <color name="gutter-text" value="#9399b2" />
  <color name="current-line" value="#313244" />
  <color name="selection" value="#24534f" />
  <color name="accent" value="#94e2d5" />

  <style name="text" foreground="foreground" background="background" />
  <style name="selection" foreground="#cdd6f4" background="selection" />
  <style name="selection-unfocused" foreground="foreground" background="#313f45" />
  <style name="cursor" foreground="#94e2d5" />
  <style name="current-line" background="current-line" />
  <style name="line-numbers" foreground="gutter-text" background="gutter" />
  <style name="line-numbers-border" background="#45475a" />
  <style name="current-line-number" foreground="#94e2d5" background="#313244" bold="true" />
  <style name="bracket-match" foreground="#cdd6f4" background="#45475a" bold="true" />
  <style name="bracket-mismatch" foreground="#cdd6f4" background="#f38ba8" bold="true" />
  <style name="search-match" foreground="#1e1e2e" background="#f9e2af" />

  <style name="def:comment" foreground="#9399b2" italic="true" />
  <style name="def:keyword" foreground="#cba6f7" bold="true" />
  <style name="def:statement" foreground="#cba6f7" bold="true" />
  <style name="def:string" foreground="#a6e3a1" />
  <style name="def:character" foreground="#a6e3a1" />
  <style name="def:constant" foreground="#89b4fa" />
  <style name="def:decimal" foreground="#89b4fa" />
  <style name="def:float" foreground="#89b4fa" />
  <style name="def:operator" foreground="#bac2de" />
  <style name="def:type" foreground="#fab387" />
  <style name="def:function" foreground="#89dceb" />
  <style name="def:identifier" foreground="#cdd6f4" />
  <style name="def:special-char" foreground="#89b4fa" />
  <style name="def:error" foreground="#f38ba8" underline="error" />

  <style name="sql:keyword" foreground="#cba6f7" bold="true" />
  <style name="sql:comment" foreground="#9399b2" italic="true" />
  <style name="sql:string" foreground="#a6e3a1" />
  <style name="sql:number" foreground="#89b4fa" />
  <style name="sql:operator" foreground="#bac2de" />
  <style name="sql:type" foreground="#fab387" />
</style-scheme>
